def getMoneyPlayerHas( playerID):
	let result = 0
	for coin in state["coinLocations"]:
		if coin == playerID:
			result = result + 1
	return result


def givePlayerMoney( playerID, amount):
	for i in range(amount):
		assignArray( state["coinLocations"], length(state["coinLocations"]), playerID)

def havePlayerPay( playerID, amount):
	
	
	let result = 0
	let i = 0
	for coin in state["coinLocations"]:
		
		if amount > 0:
			if coin == playerID:
				amount = amount - 1
				assignArray( state["coinLocations"], i, "bank") #TODO remove it from the array
		i = i + 1
	
	
	if amount > 0:
		throwError("Tried to move off of the board")


def main():
	
	let a = 0
	while a < 12:
		print(a)
		a = a + 1
	
	let WHITE_ID = 0
	let BLACK_ID = 1
	
	let WHITE_KING_ID = 0
	let BLACK_KING_ID = 1
	
	givePlayerMoney( WHITE_ID, 15)
	givePlayerMoney( BLACK_ID, 15)
	
	uiUpdateState()
	
	for i in range(9999):#TODO while loop wasnt working
		
		
		#TODO I dont know why this check is needed, but without it it fails with an error
		# if length(getAllPiecesOnBoardOfCertainColorIDs(WHITE_ID)) == 0:
		# 	endGame("Black won")
		# 	return "Black won"
		if !state["pieces"][WHITE_KING_ID]["position"]["onBoard"]:
			endGame("Black won")
			return "Black won"
		
		let choices = simulateAllChoicesInFunction("doPlayerTurn", WHITE_ID)
		
		let viableChoices = filterA( choices, "isNotErr")
		if length(viableChoices) == 0:
			endGame("Stalemate")
			return "Stalemate"
		
		
		let choice = getUserChoice( WHITE_ID, "Pick an action", viableChoices)
		
		setState(viableChoices[choice]) #TODO i should be able to just do state = blablabla, but that does not work for now with the interpreter
		
		uiUpdateState()
		
		# Now do the buying part
		givePlayerMoney( WHITE_ID, 1)
		buyPhase(WHITE_ID)
		
		uiUpdateState()
		
		# if length(getAllPiecesOnBoardOfCertainColorIDs(BLACK_ID)) == 0:
		# 	endGame("White won")
		# 	return "White won"
		if !state["pieces"][BLACK_KING_ID]["position"]["onBoard"]:
			endGame("White won")
			return "White won"
		
		let choices2 = simulateAllChoicesInFunction("doPlayerTurn", BLACK_ID)
		
		let viableChoices2 = filterA( choices2, "isNotErr")
		if length(viableChoices2) == 0:
			endGame("Stalemate")
			return "Stalemate"
		
		
		let choice2 = getUserChoice( BLACK_ID, "Pick an action", viableChoices2)
		assignArray(state, "pieces", viableChoices2[choice2]["pieces"])
		
		
		uiUpdateState()
		
		# Now do the buying part
		givePlayerMoney( BLACK_ID, 1)
		buyPhase(BLACK_ID)
		
		uiUpdateState()
	





#TODO the uiHint function needs some simplifying. Currently if not in a sim it gives the possibilities. If in a sim it sets the startLoc or endLoc (whichever is specified)
def doPlayerTurn(playerID):
	
	let idOfPieceToMove = getUserChoiceOfArray( playerID, getAllPiecesOnBoardOfCertainColorIDs(playerID), range(length(getAllPiecesOnBoardOfCertainColorIDs(playerID))), "Pick a piece to move" )
	
	
	# UI hint stuff
	let loc = getPieceLocation( idOfPieceToMove)
	assignArray(state, "startLoc", createLoc(loc["x"],loc["y"])) #While not strictly required, this is really helpful for the UI
	
	state["pieces"][idOfPieceToMove]["actionFunction"]( playerID, idOfPieceToMove)
	
	
	
	# UI hint stuff
	let loc = getPieceLocation( idOfPieceToMove)
	assignArray(state, "endLoc", createLoc(loc["x"],loc["y"])) #While not strictly required, this is really helpful for the UI
	# let b = createEmptyArray(1)
	# assignArray(b, "endLoc", createLoc(loc["x"],loc["y"]))
	# uiHint(b) #I dont know why the assiging to state thing worked for the first part but not for the second part. For whatever reason it wasnt working so I did this UI hint thing
	
	# uiUpdateState(1) #This would do nothing since this is in a sim


def buyPhase( playerID):
	
	for i in range(1000):
		
		let options = getMarket()
		assignArray( options, length(options), "Done")
		let choice = getUserChoice( playerID, "Market", options)
		
		if choice == length(options) - 1:
			return 1
		
		buyPiece( playerID, choice)

def getAllLocs():
	let result = createEmptyArray()
	for i in range(8):
		for j in range(8):
			let loc = createEmptyArray()
			assignArray( loc, "x", i)
			assignArray( loc, "y", j)
			assignArray( result, i + j * 8, loc)
	return result


def getAllLocsABoughtPieceCanGo( playerID):
	let result = createEmptyArray()
	for loc in getAllLocs():
		if playerID == 0 & loc["y"] < 2:
			assignArray( result, length(result), loc)
		if playerID == 1 & loc["y"] > 5:
			assignArray( result, length(result), loc)
	
	result = filterA( result, "isLocOccupied")
	
	return result


def isLocOccupied( loc):
	return length(getPiecesAtLoc( loc)) == 0


def payCostOfBuyingPiece( playerID, piece):
	piece["doPurchaseCost"]( playerID, piece["id"])

def buyPiece( playerID, placeInMarket):
	
	
	# let choices = simulateAllChoicesInFunction("doPlayerTurn", playerID, getMarket()[placeInMarket])
	
	
	let piece = getMarket()[placeInMarket]
	
	#To see if the player can pay the cost of the piece, we simulate doing the cost function. The cost function is almost always making the player pay money to the bank, but it can be any function in general
	let resultStates = simulateAllChoicesInFunction("payCostOfBuyingPiece", playerID, piece)
	
	#There could be a user choice within the cost function, so account for that possibility
	let viableChoices = filterA( resultStates, "isNotErr")
	if length(viableChoices) == 0:
		#There are no cases where the player can pay the cost
		print("cant buy that, too expensive")
		return 1 #return without actually buying the piece
	
	if length(viableChoices) > 1:
		throwError("TODO not supported yet")
	
	setState(viableChoices[0]) #TODO i should be able to just do state = blablabla, but that does not work for now with the interpreter
	
	let piece = getMarket()[placeInMarket] #we need to reset it because it no longer corresponds to the actual piece because the state has been reset TODO make it so this is not needed
	
	let locationToPlace = getUserChoiceOfArray( playerID, getAllLocsABoughtPieceCanGo( playerID), getAllLocsABoughtPieceCanGo( playerID), "Where to put the new piece?")
	
	
	assignArray( piece["position"], "inMarket", 0)
	assignArray( piece["position"], "onBoard", 1)
	assignArray( piece["position"], "x", locationToPlace["x"])
	assignArray( piece["position"], "y", locationToPlace["y"])
	assignArray( piece["position"], "color", playerID)
	
	replenishMarket()
	uiUpdateState()


def getStack():
	let result = createEmptyArray()
	for piece in state["pieces"]:
		if piece["position"]["inStack"]:
			assignArray( result, piece["position"]["stackPosition"], piece)
	return result





# The high numbers are at the top of the stack. 0 is the bottom card of the stack
def replenishMarket():
	
	
	let MARKET_SIZE = 8
	
	# print(getMarket(1))
	
	let stack = getStack()
	
	if !length(stack):
		throwError("Ran out of cards, cannot replenish the market")
	
	
	for i in range(1000):
		
		#First, we need to see if the market has any holes. We cannot just take the length of getMarket, because currently that returns an array with holes in it
		let numOfMarketCards = 0
		for piece in getMarket():
			if piece:
				if piece["position"]:
					if piece["position"]["inMarket"]:
						numOfMarketCards = numOfMarketCards + 1
		
		if numOfMarketCards == MARKET_SIZE:
			return 1
		
		
		let topPieceOfDeck = stack[length(stack) - 1]
		assignArray( topPieceOfDeck["position"], "inStack", 0)
		assignArray( topPieceOfDeck["position"], "inMarket", 1)
		assignArray( topPieceOfDeck["position"], "marketPosition", getEmptyMarketPosition())
		
	uiUpdateState()
	



def getEmptyMarketPosition():
	
	let MARKET_SIZE = 8
	let market = getMarket()
	let isThingPresent = createEmptyArray()
	
	
	for i in range(MARKET_SIZE):
		assignArray( isThingPresent, i, 0)
	
	
	for piece in market:
		if piece:
			if piece["position"]:
				if piece["position"]["inMarket"]:
					assignArray( isThingPresent, piece["position"]["marketPosition"], 1)
	
	
	for i in range(length(isThingPresent)):
		if !isThingPresent[i]:
			return i
	
	throwError("Error tried to get an empty market spot, but the market is all full")
	


def getMarket():
	let result = createEmptyArray()
	for piece in state["pieces"]:
		if piece["position"]["inMarket"]:
			assignArray( result, piece["position"]["marketPosition"], piece)
	return result


