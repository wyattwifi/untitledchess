


def canPieceLandOnSpace( piece, loc):
	
	assertLocIsOnBoard(loc)
	
	#By default, it can only land on it if there are no pieces on it that it cannot capture
	let piecesAtLoc = getPiecesAtLoc(loc)
	
	for attackedPiece in piecesAtLoc:
		if !canPieceCapturePiece( piece, attackedPiece):
			return 0
	return 1


def canPieceLandOnSpaceWithoutCapturing( piece, loc):
	
	assertLocIsOnBoard(loc)
	
	#By default, it can only land on it if there are no pieces on it that it cannot capture
	let piecesAtLoc = getPiecesAtLoc(loc)
	
	if length( piecesAtLoc) > 0:
		return 0
	return 1


def canPieceCapturePiece( attackingPiece, defendingPiece):
	
	#friends cannot attack each other
	if attackingPiece["position"]["color"] == defendingPiece["position"]["color"]:
		return 0
	
	return 1



#This ignores capturing etc but does handle staying on the board
def movePieceInDirection( theMovingPieceId, direction):
	
	movePiece( theMovingPieceId, getLocOneSpaceInDirection( getPieceLocation(theMovingPieceId), direction))


def movePiece( theMovingPieceId, newLocation):
	
	#TODO do this better
	
	
	# the old position still has the correct onBoard and color properties, so we need to not overwrite those
	assignArray(state["pieces"][theMovingPieceId]["position"], "x", newLocation["x"])
	assignArray(state["pieces"][theMovingPieceId]["position"], "y", newLocation["y"])
	
	
	


def captureAllPiecesAtLoc( loc):
	
	let piecesIDsToCapture = getPiecesAtLoc( loc)
	
	for pieceID in piecesIDsToCapture:
		capturePiece(pieceID)


def capturePiece( pieceID):
	assignArray(state["pieces"][pieceID]["position"], "onBoard", 0)


def capturePieceBrickVariant( pieceID):
	if pieceID == 0:
		givePlayerMoney( 0, 2)
	assignArray(state["pieces"][pieceID]["position"], "onBoard", 0)



def moveWithoutCapturing( piece, direction):
	
	let startingLoc = piece["position"] #this has some other information too, but for now it is good enough
	
	let newLoc = getLocOneSpaceInDirection( startingLoc, direction)
	
	if !canPieceLandOnSpaceWithoutCapturing( piece, newLoc):
		throwError("Tried to move off of the board")
	
	movePiece(piece["id"], newLoc)



def putCardOnTopOfStack( piece):
	let stackLength = length(getStack())
	assignArray( piece["position"], "inMarket", 0)
	assignArray( piece["position"], "onBoard", 0)
	assignArray( piece["position"], "inStack", 1)
	assignArray( piece["position"], "stackPosition", stackLength)



def getAllAdjacentLocs(loc):
	let dirs = getAllDirections()
	let locs = createEmptyArray()
	let i = 0
	for dir in dirs:
		assignArray( locs, i, getLocOneSpaceInDirectionErrorless( loc, dir))
		i = i + 1
	
	locs = filterA( locs, "isLocOnBoard")
	# print(locs)
	return locs






def getLocOneSpaceInDirection( startingLoc, direction):
	let newLoc = "placeholder"
	if direction == 0:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] + 1)
	if direction == 1:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] + 0)
	if direction == 2:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] - 1)
	if direction == 3:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] + 0)
	if direction == 4:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] + 1)
	if direction == 5:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] - 1)
	if direction == 6:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] - 1)
	if direction == 7:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] + 1)
	
	if !isLocOnBoard( newLoc):
		throwError("Tried to move off of the board")
	return newLoc
	# throwError("not a valid direction")







def getLocOneSpaceInDirectionErrorless( startingLoc, direction):
	let newLoc = "placeholder"
	if direction == 0:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] + 1)
	if direction == 1:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] + 0)
	if direction == 2:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] - 1)
	if direction == 3:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] + 0)
	if direction == 4:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] + 1)
	if direction == 5:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] - 1)
	if direction == 6:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] - 1)
	if direction == 7:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] + 1)
	
	return newLoc


