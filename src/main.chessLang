def main():
	
	uiUpdateState(1)
	
	for i in range(9999):#TODO while loop wasnt working
		
		
		#TODO I dont know why this check is needed, but without it it fails with an error
		if length(getAllPiecesOnBoardOfCertainColorIDs(0)) == 0:
			endGame("Black won")
			return "Black won"
		
		let choices = simulateAllChoicesInFunction("doPlayerTurn", 0)
		
		let viableChoices = filterA( choices, "isNotErr")
		if length(viableChoices) == 0:
			endGame("Black won")
			return "Black won"
		
		let choice = getUserChoice( 0, "Pick an action", viableChoices)
		assignArray(state, "pieces", viableChoices[choice]["pieces"])#TODO it should assign the entire state. Currently this deletes important parts of the state
		
		
		uiUpdateState(1)
		
		# Now do the buying part
		let marketSize = 4
		
		
		
		if length(getAllPiecesOnBoardOfCertainColorIDs(1)) == 0:
			endGame("White won")
			return "White won"
		
		let choices2 = simulateAllChoicesInFunction("doPlayerTurn", 1)
		
		let viableChoices2 = filterA( choices2, "isNotErr")
		if length(viableChoices2) == 0:
			endGame("White won")
			return "White won"
		
		
		let choice2 = getUserChoice( 1, "Pick an action", viableChoices2)
		assignArray(state, "pieces", viableChoices2[choice2]["pieces"])
		
		
		uiUpdateState(1)
		
	



def movePiece( theMovingPieceId, newLocation):
	
	#TODO do this better
	
	
	# the old position still has the correct onBoard and color properties, so we need to not overwrite those
	assignArray(state["pieces"][theMovingPieceId]["position"], "x", newLocation["x"])
	assignArray(state["pieces"][theMovingPieceId]["position"], "y", newLocation["y"])
	
	
	


def captureAllPiecesAtLoc( loc):
	let piecesIDsToCapture = getPiecesAtLoc( loc)
	for theID in piecesIDsToCapture:
		assignArray(state["pieces"][theID]["position"], "onBoard", 0)
	









def getLocOneSpaceInDirection( startingLoc, direction):
	let newLoc = "placeholder"
	if direction == 0:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] + 1)
	if direction == 1:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] + 0)
	if direction == 2:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] - 1)
	if direction == 3:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] + 0)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	if !isLocOnBoard( newLoc):
		throwError("Tried to move off of the board")
	return newLoc
	# throwError("not a valid direction")





def getForwardDirection( piece):
	#this returns the direction that is forward for a piece. This varies piece-to-piece because the different colors head in opposite directions

def jumpForwardOne( piece):
	# this is a very simple piece that just jumps forward one space, capturing if able

	let location = getPieceLocation( piece)
	let newLocation = getLocationInDirectionFromLocation( location, getForwardDirection(piece))
	let canMove = canPieceMoveToLocation(newLocation)
	if canMove:
		movePiece( piece, newLocation)
		
	if !canMove:
		throwError("aaa")



#TODO the uiHint function needs some simplifying. Currently if not in a sim it gives the possibilities. If in a sim it sets the startLoc or endLoc (whichever is specified)
def doPlayerTurn(playerID):
	
	let idOfPieceToMove = getUserChoiceOfArray( playerID, getAllPiecesOnBoardOfCertainColorIDs(playerID), range(length(getAllPiecesOnBoardOfCertainColorIDs(playerID))), "Pick a piece to move" )
	
	
	# UI hint stuff
	let loc = getPieceLocation( idOfPieceToMove)
	assignArray(state, "startLoc", createLoc(loc["x"],loc["y"])) #While not strictly required, this is really helpful for the UI
	
	state["pieces"][idOfPieceToMove]["actionFunction"]( playerID, idOfPieceToMove)
	
	
	
	# UI hint stuff
	let loc = getPieceLocation( idOfPieceToMove)
	# assignArray(state, "endLoc", createLoc(loc["x"],loc["y"])) #While not strictly required, this is really helpful for the UI
	let b = createEmptyArray(1)
	assignArray(b, "endLoc", createLoc(loc["x"],loc["y"]))
	uiHint(b) #I dont know why the assiging to state thing worked for the first part but not for the second part. For whatever reason it wasnt working so I did this UI hint thing
	
