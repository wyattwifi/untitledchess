# WARNING for some unknown reason, using the name "filter" insetad of "filterA" makes it fail with an error
def filterA( arrayIn, condition):
	let newArray = createEmptyArray(1)
	let i = 0
	for item in arrayIn:
		if condition(item):
			assignArray( newArray, i, item)
			i = i + 1
	return newArray


def isNotErr(thingToCheck):
	return !(thingToCheck == "err")




def getAllPiecesOnBoardIDs( a):
	let result = createEmptyArray(1)
	let i = 0
	let j = 0
	for piece in state["pieces"]:
		if piece["position"]["onBoard"]:
			assignArray( result, i, j)
			i = i + 1
		j = j + 1
	return result


def getAllPiecesOnBoardOfCertainColorIDs( userID):
	let result = createEmptyArray(1)
	let i = 0
	let j = 0
	for piece in state["pieces"]:
		if piece["position"]["onBoard"] & piece["position"]["color"] == userID:
			assignArray( result, i, j)
			i = i + 1
		j = j + 1
	return result


def getPieceColor( pieceID):
	return state["pieces"][pieceID]["position"]["color"]


def getAllOrthogonalDirections(unused):
	return range(4)

def isLocOnBoard( loc):
	
	if loc["x"] < 0:
		return 0
	if loc["x"] > 7:
		return 0
	if loc["y"] < 0:
		return 0
	if loc["y"] > 7:
		return 0
	return 1

def getUserChoiceOfArray( userID, array):
	# return array[0]
	return array[getUserChoice( userID, length(array))]



def getDirectionsPerpendicularToDirection( directionIn):
	if directionIn == 0 | directionIn == 2:
		return createArray( 1, 3)
	if directionIn == 1 | directionIn == 3:
		return createArray( 0, 2)



def getPieceLocation( pieceID):
	return state["pieces"][pieceID]["position"]


def doLeaperMove( userID, theMovingPieceId, firstAmount, secondAmount):

	let firstDirection = getUserChoiceOfArray( userID, getAllOrthogonalDirections(1))
	let secondDirection = getUserChoiceOfArray( userID, getDirectionsPerpendicularToDirection( firstDirection))
	# walk along the path, making sure that each space is either empty, itself (because when it moves in it will also move out), or (on the last space only) a capturable enemy piece

	for i in range(firstAmount):
		let location = getPieceLocation( theMovingPieceId)
		let newLocation = getLocOneSpaceInDirection( location, firstDirection)
		
		
		movePiece( theMovingPieceId, newLocation)
			
	for unused in range(secondAmount):
		let location = getPieceLocation( theMovingPieceId)
		let newLocation = getLocOneSpaceInDirection( location, secondDirection)
# 		
# 		if !isLocationEmpty( newLocation):#TODO what if it is being blocked by itself
# 			# a piece is there. The only way this can move there is if that piece is itself, or if 
# 			throwError()
# 			
		movePiece( theMovingPieceId, newLocation)
					
					
				
				
				





def movePiece( theMovingPieceId, newLocation):
	# the old position still has the correct onBoard and color properties, so we need to copy those over
	let oldPosition = state["pieces"][theMovingPieceId]["position"]
	assignArray(state["pieces"][theMovingPieceId]["position"], "x", newLocation["x"])
	assignArray(state["pieces"][theMovingPieceId]["position"], "y", newLocation["y"])
	# setState( newLocation, "pieces", theMovingPieceId, "position")













def getLocOneSpaceInDirection( startingLoc, direction):
	let newLoc = "placeholder"
	if direction == 0:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] + 1)
	if direction == 1:
		newLoc = createLoc( startingLoc["x"] + 1, startingLoc["y"] + 0)
	if direction == 2:
		newLoc = createLoc( startingLoc["x"] + 0, startingLoc["y"] - 1)
	if direction == 3:
		newLoc = createLoc( startingLoc["x"] - 1, startingLoc["y"] + 0)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	# if direction == 0:
	# 	newLoc = createLoc( pieceLoc["x"] + 1, pieceLoc["y"] + 1)
	if !isLocOnBoard( newLoc):
		throwError("Tried to move off of the board")
	return newLoc
	# throwError("not a valid direction")








